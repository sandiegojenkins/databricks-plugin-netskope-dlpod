# ---------------------------------------------------------------------------
# Netskope DLP On Demand (DLPoD) <-> Databricks adapter — deploy config.
# Copy this to `.env` and fill in. `.env` is gitignored; this `.env.example`
# is committed. NO SECRETS GO HERE.
#
# AWS credentials are NOT set in this file. Use your normal aws CLI config /
# SSO / environment. Confirm with:  aws sts get-caller-identity
#
# THIS ASSUMES A DLPOD APPLIANCE IS ALREADY DEPLOYED AND TETHERED to your
# Netskope tenant, reachable via an internal ALB. This repo does not deploy
# the appliance itself (that's a separate, heavier deployment involving
# license-key tethering) — only the Databricks-side adapter. See the
# solutions guide / docs/databricks-adapter.md for the prerequisites.
# ---------------------------------------------------------------------------

AWS_REGION=us-west-1
STACK_NAME=netskope-dlpod-databricks-adapter

# Same VPC as the DLPoD appliance's internal ALB.
VPC_ID=vpc-xxxxxxxx

# Any subnet in that VPC - the Lambda only needs VPC-local reachability to
# the appliance's internal ALB, not internet/NAT access.
LAMBDA_SUBNET_IDS=subnet-xxxxxxxx

# Optional overrides — template defaults assume the DLPoD standalone
# reference deployment's naming convention:
#DLP_EVALUATION_URL=https://dlp.dlpod.internal/inspections
#CERT_PARAMETER_NAME=/netskope-dlpod/dlpod-cert

# Optional fallback DLP profile name(s), comma-separated, used only if a
# Databricks attachment's policy_config doesn't supply its own profiles.
# Leave blank to require every attachment to configure its own.
#DEFAULT_PROFILES=

# Whether DLPoD posts alerts/incidents to the Netskope management plane
# (SkopeIT) for matches this adapter finds. Leave 'true' unless you have a
# specific reason to inspect without logging - without it, DLP matches
# still correctly block, but nothing shows up in SkopeIT.
#GENERATE_INCIDENTS=true

# ===== Optional org tagging =====
# Only the ones you set are applied - leave all commented to skip tagging.
#TAG_OWNER=you@example.com
#TAG_PROJECT_TYPE=internal
#TAG_COST_CENTER=
#TAG_STAGE=lab
#TAG_SENSITIVITY=none

# Optional: path to a corporate TLS-inspection CA bundle, if your machine
# needs one for aws/curl. Leave commented if not applicable.
#CA_BUNDLE=C:\path\to\corp-ca-bundle.pem
